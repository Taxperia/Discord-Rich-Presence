{
  "name": "cursor-presence",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "1.2.0",
  "publisher": "Taxperia",
  "repository": {
    "type": "git",
    "url": "https://github.com/Taxperia/Discord-Rich-Presence.git"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "icon": "logo.png",
  "main": "./out/extension.js",
  "extensionKind": [
    "ui"
  ],
  "contributes": {
    "commands": [
      {
        "command": "cursorDiscord.reconnect",
        "title": "%command.reconnect%"
      },
      {
        "command": "cursorDiscord.disconnect",
        "title": "%command.disconnect%"
      },
      {
        "command": "cursorDiscord.openSettings",
        "title": "%command.openSettings%"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "%config.title%",
      "properties": {
        "cursorDiscord.enabled": {
          "type": "boolean",
          "default": true,
          "order": 1,
          "description": "%config.enabled%"
        },
        "cursorDiscord.language": {
          "type": "string",
          "default": "auto",
          "order": 2,
          "enum": [
            "auto",
            "en",
            "tr"
          ],
          "enumDescriptions": [
            "%config.language.auto%",
            "%config.language.en%",
            "%config.language.tr%"
          ],
          "description": "%config.language%"
        },
        "cursorDiscord.largeImageMode": {
          "type": "string",
          "default": "languageText",
          "order": 3,
          "enum": [
            "editor",
            "languageText",
            "languageTextEditor",
            "languageOutline",
            "languageOutlineEditor",
            "languageLogo"
          ],
          "enumDescriptions": [
            "%config.largeImageMode.editor%",
            "%config.largeImageMode.languageText%",
            "%config.largeImageMode.languageTextEditor%",
            "%config.largeImageMode.languageOutline%",
            "%config.largeImageMode.languageOutlineEditor%",
            "%config.largeImageMode.languageLogo%"
          ],
          "description": "%config.largeImageMode%"
        },
        "cursorDiscord.privacyMode": {
          "type": "boolean",
          "default": false,
          "order": 4,
          "description": "%config.privacyMode%"
        },
        "cursorDiscord.showSmallEditorIcon": {
          "type": "boolean",
          "default": true,
          "order": 5,
          "description": "%config.showSmallEditorIcon%"
        },
        "cursorDiscord.showWorkspace": {
          "type": "boolean",
          "default": true,
          "order": 10,
          "description": "%config.showWorkspace%"
        },
        "cursorDiscord.showFileName": {
          "type": "boolean",
          "default": true,
          "order": 11,
          "description": "%config.showFileName%"
        },
        "cursorDiscord.showLanguage": {
          "type": "boolean",
          "default": true,
          "order": 12,
          "description": "%config.showLanguage%"
        },
        "cursorDiscord.showElapsedTime": {
          "type": "boolean",
          "default": true,
          "order": 13,
          "description": "%config.showElapsedTime%"
        },
        "cursorDiscord.customDetails": {
          "type": "string",
          "default": "",
          "order": 20,
          "markdownDescription": "%config.customDetails%"
        },
        "cursorDiscord.customState": {
          "type": "string",
          "default": "",
          "order": 21,
          "markdownDescription": "%config.customState%"
        },
        "cursorDiscord.idleMessage": {
          "type": "string",
          "default": "",
          "order": 22,
          "description": "%config.idleMessage%"
        }
      }
    }
  },
  "scripts": {
    "assets": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-rich-presence-assets.ps1 && node scripts/generate-asset-manifest.cjs",
    "readme:assets": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-readme-showcase.ps1",
    "build": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --target=node18 --minify",
    "watch": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --target=node18 --watch",
    "vscode:prepublish": "npm run build",
    "assets:manifest": "node scripts/generate-asset-manifest.cjs",
    "assets:check": "node scripts/generate-asset-manifest.cjs --check",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.cjs",
    "test:taxcode": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-taxcode.ps1"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.74.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.3.0"
  }
}
